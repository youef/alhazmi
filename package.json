{
  "name": "alhazmi-diwani",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @alhazmi/web",
    "build": "npm run build --workspace @alhazmi/web",
    "typecheck": "npm run typecheck --workspace @alhazmi/web",
    "lint": "npm run lint --workspace @alhazmi/web",
    "test": "npm run test --workspace @alhazmi/web",
    "functions:build": "node ./backend/neon/build.mjs",
    "functions:check": "node --check backend/neon/api.js && node --check backend/neon/uploads.js && node --check backend/neon/shared.js && node --check backend/neon/members.js && node --check backend/neon/member-auth.js && node --check backend/neon/member-views.js",
    "check": "npm run functions:check && npm run functions:test",
    "build:functions": "node ./backend/neon/build.mjs",
    "functions:test": "node --test backend/neon/members.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@neon/config": "^1.13.0",
    "@neon/functions": "^0.8.0",
    "@neondatabase/auth": "0.7.0-beta",
    "jose": "^6.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
